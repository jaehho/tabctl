{
  "manifest_version": 3,
  "name": "tabctl",
  "version": "0.4.0",
  "description": "Lets the tabctl command list, focus, open and group Firefox tabs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabctl@jaeho.dev",
      "update_url": "https://raw.githubusercontent.com/jaehho/tabctl/main/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["nativeMessaging", "tabs", "tabGroups"],
  "background": {
    "scripts": ["background.js"]
  }
}
